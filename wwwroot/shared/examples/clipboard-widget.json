{
  "version": 2,
  "widget": "desk.clipboard",
  "kind": "clipboard",
  "name": "剪贴板历史",
  "size": "large",
  "color": "#b8c9f2",
  "permissions": ["clipboard", "actions"],
  "refreshMs": 850,
  "layout": {
    "columns": 1,
    "gap": 8,
    "padding": 14,
    "align": "start"
  },
  "empty": {
    "text": "暂无内容",
    "color": "#a5abb7",
    "opacity": 0.52,
    "fontScale": 0.72
  },
  "blocks": [
    {
      "kind": "history",
      "source": "clipboard.history",
      "hideWhenEmpty": true,
      "action": { "type": "clipboard.history.paste" }
    }
  ]
}
